APP_NAME="LMS Plataforma"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://lms.suaempresa.com

LOG_CHANNEL=daily
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=lms
DB_USERNAME=lms_user
DB_PASSWORD=troque-esta-senha
DB_ROOT_PASSWORD=troque-a-senha-root

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

MAIL_MAILER=smtp
MAIL_HOST=smtp.exemplo.com
MAIL_PORT=587
MAIL_USERNAME=usuario
MAIL_PASSWORD=senha
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@suaempresa.com"
MAIL_FROM_NAME="${APP_NAME}"

WEB_PORT=8080
